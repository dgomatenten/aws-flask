# Local development only. Do not use this file in ECS production.
# In ECS, inject these values from AWS Secrets Manager.

FLASK_ENV=development
SECRET_KEY=change-me-for-local-dev
APP_PORT=8000

# PostgreSQL connection details
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flask_auth
DB_USER=flask_user
DB_PASSWORD=flask_password

# Optional: Set to true if connecting to RDS with SSL required
DB_SSLMODE=prefer

# Optional bootstrap user for first run
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
